  "integration_contract": {
    "data_element": "tlog.html preserves the original inline script[type=\"application/json\"]#TlogData; tlog-data.json is the same source text as a separate reusable data file.",
    "execution": "Load tlog.css, insert tlog.html markup, then load tlog.js as a classic deferred script after that markup. Native inline IIFE is unchanged.",
    "dependencies": "Only native browser APIs and four Montserrat font URLs referenced by tlog.css; no Shopify, jQuery or other runtime global is referenced. Pagination uses same-origin fetch only if data.pages > 1; captured data.pages is 1.",
    "source_context": "Feature CSS retains original #shopify-section-footer display:none rule. tlog.html includes the source Home link href=\"/\". Host page supplies body margin/reset, .visually-hidden and outer page width/gutters from the full site.",
    "links": "Viewer hash uses #photo-ID. Copy Link constructs location.origin + /search?q=photo-ID&view=tlog, a Shopify-specific preview route; porting that route requires an explicitly documented host adaptation.",
    "storage": [
      "fugazi-tlog-likes",
      "fugazi-tlog-cols",
      "fugazi-tlog-view"
    ],
    "starting_position": "Oldest-first sort, viewport initially jumps to newest/bottom; explicit #photo-ID opens that photo.",
    "original_controls": [
      "Years/Months/All",
      "Library/Favorites",
      "grid density pinch",
      "open/close morph",
      "horizontal native snap/swipe",
      "pinch/double-tap zoom",
      "photo info",
      "favorites",
      "video play/mute/scrub",
      "share/save",
      "copy link"
    ]
  },
